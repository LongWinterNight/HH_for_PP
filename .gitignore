# ═══════════════════════════════════════════════════
# Frontend (Vite)
# ═══════════════════════════════════════════════════

frontend/node_modules/
frontend/dist/
frontend/.vite/

# Локальный прокси-клиент (бинарники, ~62 МБ) — инструмент машины, не проекта
.hh_proxy/

# Бэкапы базы: правило data/*.db их не ловит из-за суффикса с датой
data/*.db.bak_*
data/backups/

# Сырые выгрузки источника: полгигабайта чужих данных, которые
# восстанавливаются сбором. Ранее добавленные файлы остаются в истории.
data/raw/
# Кэш справочника регионов: перечитывается из сети раз в месяц.
data/areas.json
# Выгрузки и отчёты — результат работы, а не исходники.
data/reports/
# Очередь на разметку эталона: собирается скриптом из сырья.
data/очередь_эталона.json
# Резервные копии конфигурации.
*.bak
# Адрес и логин тестового стенда: репозиторий публичный.
docs/access-for-testing.md
# Снимки и журналы проверки интерфейса в браузере.
.playwright-mcp/

# Журнал работы и журнал оповещений: состояние этой машины, не исходники.
logs/

# Расписание сбора — состояние этой машины, а не проекта
data/schedule.json

# Закрытые рабочие документы: в публичный репозиторий не идут
docs/private/

# Служебные файлы SQLite: журнал отката и WAL появляются на время записи.
# 15.10.2026 журнал рабочей базы (37 МБ данных вакансий) попал в коммит,
# потому что в момент git add шла запись разбора.
data/*.db-journal
data/*.db-wal
data/*.db-shm
