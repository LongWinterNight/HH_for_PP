# HH.ru API Configuration
# ⚠️ ВАЖНО: Укажите email от вашего аккаунта HH.ru!
# Без email парсер не запустится. Пользователь также может указать email через интерфейс.
HH_USER_EMAIL=your_email@example.com

# ⚠️ ОБЯЗАТЕЛЬНО с 2025 года: OAuth access_token приложения.
# HH.ru закрыл анонимный поиск вакансий — без токена /vacancies отдаёт 403.
# Как получить: https://dev.hh.ru/admin → создать приложение → скопировать access_token.
HH_ACCESS_TOKEN=

# Прокси для запросов к HH.ru (нужен, если IP вне РФ). Пример: http://127.0.0.1:7899
HH_PROXY=

# Rate Limiting (задержка между запросами в секундах)
# Рекомендуется не менее 1.0 секунды
API_REQUEST_DELAY=1.0

# Лимиты сбора данных
MAX_PAGES=10
DAYS_BACK=30

# Резка запроса на срезы по регионам и датам.
#
# Источник отдаёт не больше 2000 вакансий на запрос, сколько бы ни
# «нашёл»: по «Рекрутеру» он знает 10 294 и показывает пятую часть.
# Упёршийся запрос режется по странам, регионам и, если делить больше
# нечем, по датам публикации.
#
# Включено по умолчанию. Раньше стояло «false», потому что цена резки
# считалась вместе с карточками вакансий и выходила неподъёмной. Теперь
# охват отделён от глубины: внутри среза читается только выдача, а
# карточки догоняет отдельный проход (scripts/maintenance/дозапрос_
# деталей.py). Выключать имеет смысл для быстрого поверхностного прохода
# — на экране сбора для этого есть галочка «Собирать глубоко».
#
# MAX_SLICES — предохранитель: сколько срезов сбор вправе обойти за
# запуск. Срезы обходятся от крупных к мелким, поэтому предел отсекает
# наименее важные. Источник вправе назвать свой предел — берётся меньший.
РЕЗАТЬ_УПЁРШИЕСЯ=true
MAX_SLICES=100

# Сроки жизни кэша ответов, в часах.
#
# Выдача и карточка живут по-разному. Страница выдачи меняется быстро:
# работодатель публикует вакансию утром, и вечерний сбор по вчерашнему
# кэшу её не увидит. Карточка почти не меняется — текст правят редко, а
# зарплата и статус приходят из выдачи, — зато запрашивается на каждую
# новую вакансию: это тысячи обращений на сбор.
#
# Раньше срок был один на двоих и зашит в код (24 часа): поменять его
# можно было только правкой вызова.
КЭШ_ВЫДАЧИ_ЧАСОВ=6
КЭШ_КАРТОЧЕК_ЧАСОВ=168

# Пути к данным (относительно корня проекта)
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=data/reports

# База данных
DB_PATH=data/hh_vacancies.db

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/hh_analytics.log

# ============================================================
# Доступ к интерфейсу
# ============================================================
# Общий логин и пароль на время тестов, пока нет слоя аккаунтов.
# Оставьте пустыми для локальной работы без пароля.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# =============================================================================
# Журнал и оповещения
# =============================================================================
# Журнал работы пишется в logs/ — файл на день, хранится 30 дней.
# Пароли и токены из этого файла в журнал не попадают: их значения
# заменяются при записи. Выключить запись на диск: LOG_TO_FILE=0
# LOG_TO_FILE=1

# Оповещение об отказе сбора в Telegram. Без этих двух строк канал
# выключен, и это записывается в logs/оповещения.jsonl при каждом отказе.
# Как получить значения: python scripts/проверить_оповещение.py
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Внешний адрес стенда. Печатается в окне при запуске run-site.bat.
# В файлах репозитория адреса нет намеренно: репозиторий публичный.
# PUBLIC_URL=http://ваш-адрес:8000
